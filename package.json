{
  "name": "airsoft-fps",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "t": "vitest run --project fast --reporter=dot",
    "t:all": "vitest run --reporter=dot",
    "t:changed": "vitest run --project fast --reporter=dot --changed origin/main",
    "check": "npm run test && npm run build",
    "build:e2e": "node pipeline/build-cached.mjs --mode e2e",
    "test:browser": "playwright test",
    "check:all": "npm run check && npm run test:browser",
    "gate": "node pipeline/gate.mjs",
    "perf": "node pipeline/perf-run.mjs",
    "perf:desktop": "node pipeline/perf-desktop.mjs",
    "balance": "node pipeline/balance.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.64.0",
    "@types/three": "^0.186.0",
    "fast-check": "^4.10.2",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
